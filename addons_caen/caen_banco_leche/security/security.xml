<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- CATEGORIA Y PRIVILEGIO PARA LOS USUARIOS       -->
    <!-- ============================================= -->
    <record id="category_caen" model="ir.module.category">
        <field name="name">Banco de Leche</field>
        <field name="sequence">1</field>
    </record>
    <record id="privilege_caen" model="res.groups.privilege">
        <field name="name">Permisos</field>
        <field name="category_id" ref="category_caen"/>
    </record>

    <!-- ============================================= -->
    <!-- PERMISOS INDIVIDUALES                         -->
    <!-- ============================================= -->

    <record id="perm_donantes" model="res.groups">
        <field name="name">CAEN Donantes</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_consentimientos" model="res.groups">
        <field name="name">CAEN Consentimientos</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_visitas" model="res.groups">
        <field name="name">CAEN Visitas</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_laboratorio" model="res.groups">
        <field name="name">CAEN Laboratorio</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_frascos" model="res.groups">
        <field name="name">CAEN Frascos</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_pasteurizacion" model="res.groups">
        <field name="name">CAEN Pasteurizacion</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_distribucion" model="res.groups">
        <field name="name">CAEN Distribucion</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_pacientes" model="res.groups">
        <field name="name">CAEN Pacientes</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_nutricion" model="res.groups">
        <field name="name">CAEN Nutricion</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_stock" model="res.groups">
        <field name="name">CAEN Inventario</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_alertas" model="res.groups">
        <field name="name">CAEN Alertas</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_reportes" model="res.groups">
        <field name="name">CAEN Reportes</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>
    <record id="perm_bitacora" model="res.groups">
        <field name="name">CAEN Bitacora</field>
        <field name="privilege_id" ref="privilege_caen"/>
    </record>

    <!-- ============================================= -->
    <!-- ROLES PREDEFINIDOS                            -->
    <!-- ============================================= -->

    <!-- ADMIN: todos los permisos -->
    <record id="role_admin" model="res.groups">
        <field name="name">CAEN Administrador</field>
        <field name="implied_ids" eval="[
            (4, ref('perm_donantes')),
            (4, ref('perm_consentimientos')),
            (4, ref('perm_visitas')),
            (4, ref('perm_laboratorio')),
            (4, ref('perm_frascos')),
            (4, ref('perm_pasteurizacion')),
            (4, ref('perm_distribucion')),
            (4, ref('perm_pacientes')),
            (4, ref('perm_nutricion')),
            (4, ref('perm_stock')),
            (4, ref('perm_alertas')),
            (4, ref('perm_reportes')),
            (4, ref('perm_bitacora')),
        ]"/>
    </record>

    <!-- JEFE: gestiona usuarios, ve todo pero no modifica todo -->
    <record id="role_jefe" model="res.groups">
        <field name="name">CAEN Jefe</field>
        <field name="implied_ids" eval="[
            (4, ref('perm_donantes')),
            (4, ref('perm_consentimientos')),
            (4, ref('perm_visitas')),
            (4, ref('perm_laboratorio')),
            (4, ref('perm_frascos')),
            (4, ref('perm_pasteurizacion')),
            (4, ref('perm_distribucion')),
            (4, ref('perm_pacientes')),
            (4, ref('perm_nutricion')),
            (4, ref('perm_stock')),
            (4, ref('perm_alertas')),
            (4, ref('perm_reportes')),
            (4, ref('perm_bitacora')),
        ]"/>
    </record>

    <!-- ENFERMERA: donantes, consentimientos, visitas, frascos + bitacora -->
    <record id="role_enfermera" model="res.groups">
        <field name="name">CAEN Enfermera</field>
        <field name="implied_ids" eval="[
            (4, ref('perm_donantes')),
            (4, ref('perm_consentimientos')),
            (4, ref('perm_visitas')),
            (4, ref('perm_frascos')),
            (4, ref('perm_stock')),
            (4, ref('perm_alertas')),
            (4, ref('perm_bitacora')),
        ]"/>
    </record>

    <!-- TECNICO DE LABORATORIO: serologias, reportes + bitacora -->
    <record id="role_tecnico_lab" model="res.groups">
        <field name="name">CAEN Tecnico de Laboratorio</field>
        <field name="implied_ids" eval="[
            (4, ref('perm_laboratorio')),
            (4, ref('perm_donantes')),
            (4, ref('perm_stock')),
            (4, ref('perm_alertas')),
            (4, ref('perm_reportes')),
            (4, ref('perm_bitacora')),
        ]"/>
    </record>

    <!-- NUTRICIONISTA: pacientes, planes, distribuciones + bitacora -->
    <record id="role_nutricionista" model="res.groups">
        <field name="name">CAEN Nutricionista</field>
        <field name="implied_ids" eval="[
            (4, ref('perm_pacientes')),
            (4, ref('perm_nutricion')),
            (4, ref('perm_distribucion')),
            (4, ref('perm_stock')),
            (4, ref('perm_alertas')),
            (4, ref('perm_reportes')),
            (4, ref('perm_bitacora')),
        ]"/>
    </record>

    <!-- RECEPCIONISTA: consulta basica + bitacora -->
    <record id="role_recepcionista" model="res.groups">
        <field name="name">CAEN Recepcionista</field>
        <field name="implied_ids" eval="[
            (4, ref('perm_donantes')),
            (4, ref('perm_consentimientos')),
            (4, ref('perm_stock')),
            (4, ref('perm_alertas')),
            (4, ref('perm_bitacora')),
        ]"/>
    </record>

    <!-- ============================================= -->
    <!-- REGLAS DE REGISTRO                            -->
    <!-- ============================================= -->

    <record id="rule_bitacora_read" model="ir.rule">
        <field name="name">Bitacora: todos leen</field>
        <field name="model_id" ref="model_caen_bitacora"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_alertas_read" model="ir.rule">
        <field name="name">Alertas: todos leen</field>
        <field name="model_id" ref="model_caen_alerta"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_stock_read" model="ir.rule">
        <field name="name">Inventario: todos leen</field>
        <field name="model_id" ref="model_caen_stock_leche"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
