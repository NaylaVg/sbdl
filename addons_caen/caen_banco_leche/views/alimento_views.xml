<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- vista listado de alimentos con los nutrientes principales -->
    <record id="view_caen_alimento_list" model="ir.ui.view">
        <field name="name">caen.alimento.list</field>
        <field name="model">caen.alimento</field>
        <field name="arch" type="xml">
            <list string="Catalogo de alimentos">
                <field name="name"/>
                <field name="tipo"/>
                <field name="kcal"/>
                <field name="protein_g"/>
                <field name="fat_g"/>
                <field name="hc_g"/>
            </list>
        </field>
    </record>

    <!-- vista formulario con todos los nutrientes -->
    <record id="view_caen_alimento_form" model="ir.ui.view">
        <field name="name">caen.alimento.form</field>
        <field name="model">caen.alimento</field>
        <field name="arch" type="xml">
            <form string="Alimento">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tipo"/>
                        <field name="brand"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Composicion nutricional">
                            <group>
                                <field name="kcal"/>
                                <field name="protein_g"/>
                                <field name="fat_g"/>
                                <field name="hc_g"/>
                                <field name="calcium_mg"/>
                                <field name="iron_mg"/>
                                <field name="phosphorus_mg"/>
                                <field name="sodium_mg"/>
                                <field name="zinc_mg"/>
                                <field name="vit_c_mg"/>
                                <field name="vit_d_mcg"/>
                                <field name="vit_a_mcg"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- accion para abrir el catalogo -->
    <record id="action_caen_alimento" model="ir.actions.act_window">
        <field name="name">Catalogo de alimentos</field>
        <field name="res_model">caen.alimento</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- item de menu bajo nutricion -->
    <menuitem id="menu_caen_alimento"
              name="Catalogo de alimentos"
              parent="menu_caen_nutricion"
              action="action_caen_alimento"
              sequence="4"/>
</odoo>
