<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_caen_frasco_nuevo" model="ir.actions.act_window">
        <field name="name">Nuevo Frasco</field>
        <field name="res_model">caen.frasco</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_caen_frasco"/>
    </record>

    <record id="view_caen_frasco_list" model="ir.ui.view">
        <field name="name">caen.frasco.list</field>
        <field name="model">caen.frasco</field>
        <field name="arch" type="xml">
            <list string="Frascos de Leche" editable="bottom"
                  decoration-danger="state == 'raw'"
                  decoration-success="state == 'pasteurized'"
                  decoration-muted="state in ['delivered', 'discarded']">
                <header>
                    <button name="%(action_caen_frasco_nuevo)d" type="action"
                            string="+ Nuevo Frasco" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.perm_frascos"/>
                </header>
                <field name="name" string="Código QR"/>
                <field name="donor_id" string="Donante"/>
                <field name="volume_ml" string="Volumen (ml)"/>
                <field name="milk_type" string="Tipo"/>
                <field name="days_from_birth" string="Días desde nacimiento"/>
                <field name="state" string="Estado"/>
            </list>
        </field>
    </record>

    <record id="view_caen_frasco_form" model="ir.ui.view">
        <field name="name">caen.frasco.form</field>
        <field name="model">caen.frasco</field>
        <field name="arch" type="xml">
            <form string="Frasco de Leche">
                <header>
                    <button name="action_pasteurizar" type="object"
                            string="Pasteurizar" class="oe_highlight btn-success"
                            invisible="state != 'raw'"/>
                    <button name="action_fraccionar" type="object"
                            string="Fraccionar" class="oe_highlight btn-primary"
                            invisible="state != 'pasteurized'"/>
                    <button name="action_entregar" type="object"
                            string="Entregar" class="oe_highlight btn-success"
                            invisible="state != 'fractioned'"/>
                    <button name="action_descartar" type="object"
                            string="Descartar" class="btn-danger"
                            invisible="state in ['delivered', 'discarded']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos del frasco">
                            <field name="name" readonly="1"/>
                            <field name="donor_id" readonly="state != 'raw'"
                                   options="{'no_create': True}"/>
                            <field name="volume_ml" readonly="state != 'raw'"
                                   string="Volumen (ml)"/>
                            <field name="extraction_date" readonly="state != 'raw'"/>
                            <field name="reception_date" readonly="state != 'raw'"/>
                        </group>
                        <group string="Tipo y destino">
                            <field name="milk_type" readonly="1"/>
                            <field name="target" readonly="state != 'raw'"/>
                        </group>
                        <group string="Control de calidad (llenar al pasteurizar)">
                            <field name="total_col"/>
                            <field name="confirmation"/>
                        </group>
                        <group string="Composición nutricional (por 100 ml)"
                               invisible="state != 'pasteurized'">
                            <field name="hc"/>
                            <field name="protein"/>
                            <field name="fat"/>
                            <field name="calcium"/>
                        </group>
                        <group string="Inventario (automático)" invisible="not lot_id">
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="current_location_id"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'raw' or donor_apta">
                        <p><b>⚠ Donante NO apta:</b> Complete las 7 serologías y tenga consentimiento vigente antes de pasteurizar.</p>
                    </div>

                    <group string="Código QR del frasco">
                        <field name="qr_image" widget="image" class="oe_avatar"
                               style="width: 200px; height: 200px;"/>
                    </group>
                    <div class="text-center mt-2">
                        <button name="action_generar_qr" type="object"
                                string="Regenerar QR" class="btn-secondary"/>
                    </div>
                    <p class="text-muted text-center">
                        Escanee este código con el celular del banco para abrir la ficha del frasco.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_frasco" model="ir.actions.act_window">
        <field name="name">Frascos de leche</field>
        <field name="res_model">caen.frasco</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_frasco"
              name="Frascos"
              parent="menu_caen_procesos"
              action="action_caen_frasco"/>
</odoo>
