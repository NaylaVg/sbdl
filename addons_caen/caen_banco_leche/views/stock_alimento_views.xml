<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caen_stock_alimento_list" model="ir.ui.view">
        <field name="name">caen.stock_alimento.list</field>
        <field name="model">caen.stock_alimento</field>
        <field name="arch" type="xml">
            <list string="Stock de productos alimentarios">
                <field name="fecha"/>
                <field name="alimento_id"/>
                <field name="tipo_movimiento"/>
                <field name="cantidad"/>
                <field name="lote"/>
                <field name="fecha_vencimiento"/>
                <field name="origen"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_caen_stock_alimento_form" model="ir.ui.view">
        <field name="name">caen.stock_alimento.form</field>
        <field name="model">caen.stock_alimento</field>
        <field name="arch" type="xml">
            <form string="Movimiento de stock alimentario">
                <sheet>
                    <group>
                        <field name="alimento_id"/>
                        <field name="tipo_movimiento"/>
                        <field name="cantidad"/>
                        <field name="fecha"/>
                        <field name="lote"/>
                        <field name="fecha_vencimiento"/>
                        <field name="origen"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="observacion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_stock_alimento" model="ir.actions.act_window">
        <field name="name">Stock de productos alimentarios</field>
        <field name="res_model">caen.stock_alimento</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
