<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_caen_pasteurizacion_nuevo" model="ir.actions.act_window">
        <field name="name">Nueva Pasteurización</field>
        <field name="res_model">caen.pasteurizacion</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_caen_pasteurizacion"/>
    </record>

    <record id="view_caen_pasteurizacion_list" model="ir.ui.view">
        <field name="name">caen.pasteurizacion.list</field>
        <field name="model">caen.pasteurizacion</field>
        <field name="arch" type="xml">
            <list string="Pasteurizaciones">
                <header>
                    <button name="%(action_caen_pasteurizacion_nuevo)d" type="action"
                            string="+ Nueva Pasteurización" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.perm_pasteurizacion"/>
                </header>
                <field name="batch_id"/>
                <field name="new_barcode"/>
                <field name="method"/>
                <field name="volume_after"/>
                <field name="culture_24h"/>
                <field name="culture_48h"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_caen_pasteurizacion_form" model="ir.ui.view">
        <field name="name">caen.pasteurizacion.form</field>
        <field name="model">caen.pasteurizacion</field>
        <field name="arch" type="xml">
            <form string="Pasteurización">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id"/>
                            <field name="new_barcode"/>
                            <field name="method"/>
                            <field name="processed_by"/>
                            <field name="processed_at"/>
                        </group>
                        <group>
                            <field name="ac_dornic"/>
                            <field name="cream_percentage"/>
                            <field name="fat_percentage"/>
                            <field name="kcal_per_liter"/>
                            <field name="culture_24h"/>
                            <field name="culture_48h"/>
                        </group>
                    </group>
                    <group string="Volúmenes">
                        <field name="volume_before"/>
                        <field name="volume_after"/>
                        <field name="discard_volume"/>
                    </group>

                    <notebook>
                        <page string="Código QR post-pasteurización">
                            <div class="row mt-3">
                                <div class="col-4 text-center">
                                    <field name="qr_image" widget="image" class="oe_avatar"
                                           alt="QR post-pasteurización"/>
                                    <div class="mt-2">
                                        <button name="action_generar_qr" type="object"
                                                string="Regenerar QR" class="btn-secondary"/>
                                    </div>
                                </div>
                                <div class="col-8">
                                    <group>
                                        <field name="new_barcode" readonly="1"/>
                                        <field name="batch_id" readonly="1"/>
                                    </group>
                                    <p class="text-muted mt-2">
                                        Este código se asigna al frasco después de la pasteurización.
                                        Es diferente al QR del frasco crudo.
                                    </p>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_pasteurizacion" model="ir.actions.act_window">
        <field name="name">Pasteurizaciones</field>
        <field name="res_model">caen.pasteurizacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_pasteurizacion"
              name="Pasteurizaciones"
              parent="menu_caen_procesos"
              action="action_caen_pasteurizacion"/>
</odoo>
