<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caen_plan_list" model="ir.ui.view">
        <field name="name">caen.plan_alimentacion.list</field>
        <field name="model">caen.plan_alimentacion</field>
        <field name="arch" type="xml">
            <list string="Planes de Alimentación">
                <field name="patient_id"/>
                <field name="daily_volume_ml"/>
                <field name="frequency_per_day"/>
                <field name="kcal_per_day"/>
            </list>
        </field>
    </record>

    <record id="view_caen_plan_form" model="ir.ui.view">
        <field name="name">caen.plan_alimentacion.form</field>
        <field name="model">caen.plan_alimentacion</field>
        <field name="arch" type="xml">
            <form string="Plan de Alimentación">
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="daily_volume_ml"/>
                        <field name="frequency_per_day"/>
                        <field name="kcal_per_day"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <notebook>
                        <page string="Seguimiento nutricional">
                            <field name="tracking_ids">
                                <list string="Seguimientos" editable="bottom">
                                    <field name="tracking_date"/>
                                    <field name="weight_g"/>
                                    <field name="height_cm"/>
                                    <field name="head_circumference_cm"/>
                                    <field name="z_score_weight"/>
                                    <field name="z_score_height"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_plan" model="ir.actions.act_window">
        <field name="name">Planes de Alimentación</field>
        <field name="res_model">caen.plan_alimentacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_plan"
              name="Planes de Alimentación"
              parent="menu_caen_nutricion"
              action="action_caen_plan"/>
</odoo>
