<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================== -->
    <!-- VISTAS PIVOT Y GRÁFICO  -->
    <!-- ======================== -->

    <!-- Vista pivot de frascos: análisis por donante y estado -->
    <record id="view_caen_frasco_pivot" model="ir.ui.view">
        <field name="name">caen.frasco.pivot</field>
        <field name="model">caen.frasco</field>
        <field name="arch" type="xml">
            <pivot string="Frascos - Análisis">
                <field name="donor_id" type="row"/>
                <field name="state" type="col"/>
                <field name="volume_ml" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista gráfico de frascos: barras por estado -->
    <record id="view_caen_frasco_graph" model="ir.ui.view">
        <field name="name">caen.frasco.graph</field>
        <field name="model">caen.frasco</field>
        <field name="arch" type="xml">
            <graph string="Frascos - Distribución" type="bar">
                <field name="state"/>
                <field name="volume_ml" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vista pivot de serologías: análisis por donante y resultado -->
    <record id="view_caen_serologia_pivot" model="ir.ui.view">
        <field name="name">caen.serologia.pivot</field>
        <field name="model">caen.serologia</field>
        <field name="arch" type="xml">
            <pivot string="Serologías - Análisis">
                <field name="donor_id" type="row"/>
                <field name="result" type="col"/>
                <field name="study_type" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Vista gráfico de serologías: donut por resultado -->
    <record id="view_caen_serologia_graph" model="ir.ui.view">
        <field name="name">caen.serologia.graph</field>
        <field name="model">caen.serologia</field>
        <field name="arch" type="xml">
            <graph string="Serologías - Resultados" type="pie">
                <field name="result"/>
            </graph>
        </field>
    </record>

    <!-- Vista pivot de inventario: análisis por producto y ubicación -->
    <record id="view_caen_stock_pivot" model="ir.ui.view">
        <field name="name">stock.quant.pivot.caen</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <pivot string="Inventario - Análisis por Ubicación">
                <field name="location_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista gráfico de inventario: barras por ubicación -->
    <record id="view_caen_stock_graph" model="ir.ui.view">
        <field name="name">stock.quant.graph.caen</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <graph string="Inventario por Ubicación" type="bar">
                <field name="location_id"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ======================== -->
    <!-- ACCIONES DE REPORTE      -->
    <!-- ======================== -->

    <!-- 1. Frascos por Donante (pivot) -->
    <record id="action_reporte_frascos_donante" model="ir.actions.act_window">
        <field name="name">Frascos por Donante</field>
        <field name="res_model">caen.frasco</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="target">current</field>
    </record>

    <!-- 2. Frascos por Estado (gráfico) -->
    <record id="action_reporte_frascos_estado" model="ir.actions.act_window">
        <field name="name">Frascos por Estado</field>
        <field name="res_model">caen.frasco</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'group_by': 'state'}</field>
        <field name="target">current</field>
    </record>

    <!-- 3. Serologías: Pendientes vs Resultadas -->
    <record id="action_reporte_serologias_resultado" model="ir.actions.act_window">
        <field name="name">Serologías por Resultado</field>
        <field name="res_model">caen.serologia</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="target">current</field>
    </record>

    <!-- 4. Serologías Pendientes (solo las que faltan) -->
    <record id="action_reporte_serologias_pendientes" model="ir.actions.act_window">
        <field name="name">Serologías Pendientes (Reporte)</field>
        <field name="res_model">caen.serologia</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('result', '=', 'pending')]</field>
        <field name="context">{'group_by': 'donor_id'}</field>
        <field name="target">current</field>
    </record>

    <!-- 5. Inventario Actual por Ubicación (pivot) -->
    <record id="action_reporte_stock_ubicacion" model="ir.actions.act_window">
        <field name="name">Inventario por Ubicación</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('quantity', '>', 0)]</field>
        <field name="target">current</field>
    </record>

    <!-- 6. Frascos Crudos (inventario en recepción) -->
    <record id="action_reporte_stock_crudo" model="ir.actions.act_window">
        <field name="name">Inventario Leche Cruda</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('quantity', '&gt;', 0), ('location_id', 'child_of', ref('stock_location_recepcion'))]"/>
        <field name="target">current</field>
    </record>

    <!-- 7. Inventario Pasteurizado -->
    <record id="action_reporte_stock_pasty" model="ir.actions.act_window">
        <field name="name">Inventario Leche Pasteurizada</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('quantity', '&gt;', 0), ('location_id', 'child_of', ref('stock_location_heladera_pasty'))]"/>
        <field name="target">current</field>
    </record>

    <!-- 8. Donantes Aptas vs No Aptas -->
    <record id="action_reporte_donantes_aptitud" model="ir.actions.act_window">
        <field name="name">Donantes por APTITUD</field>
        <field name="res_model">caen.donante</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="target">current</field>
    </record>

    <!-- 9. Dashboard de Alertas Histórico -->
    <record id="action_reporte_alertas" model="ir.actions.act_window">
        <field name="name">Historial de Alertas</field>
        <field name="res_model">caen.alerta</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="target">current</field>
    </record>

    <!-- 10. Pacientes: Seguimiento Nutricional -->
    <record id="action_reporte_nutricion" model="ir.actions.act_window">
        <field name="name">Seguimiento Nutricional</field>
        <field name="res_model">caen.seguimiento_nutricional</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- ======================== -->
    <!-- MENÚ REPORTES            -->
    <!-- ======================== -->
    <menuitem id="menu_caen_reportes"
              name="Reportes"
              parent="menu_caen_root"
              sequence="4"/>

    <menuitem id="menu_reporte_frascos"
              name="Frascos"
              parent="menu_caen_reportes"
              sequence="1"/>
    <menuitem id="menu_reporte_frascos_donante"
              name="Frascos por Donante"
              parent="menu_reporte_frascos"
              action="action_reporte_frascos_donante"/>
    <menuitem id="menu_reporte_frascos_estado"
              name="Frascos por Estado"
              parent="menu_reporte_frascos"
              action="action_reporte_frascos_estado"/>

    <menuitem id="menu_reporte_serologias"
              name="Serologías"
              parent="menu_caen_reportes"
              sequence="2"/>
    <menuitem id="menu_reporte_serologias_resultado"
              name="Serologías por Resultado"
              parent="menu_reporte_serologias"
              action="action_reporte_serologias_resultado"/>
    <menuitem id="menu_reporte_serologias_pend"
              name="Serologías Pendientes"
              parent="menu_reporte_serologias"
              action="action_reporte_serologias_pendientes"/>

    <menuitem id="menu_reporte_stock"
              name="Inventario"
              parent="menu_caen_reportes"
              sequence="3"/>
    <menuitem id="menu_reporte_stock_ubicacion"
              name="Inventario por Ubicación"
              parent="menu_reporte_stock"
              action="action_reporte_stock_ubicacion"/>
    <menuitem id="menu_reporte_stock_crudo"
              name="Inventario Leche Cruda"
              parent="menu_reporte_stock"
              action="action_reporte_stock_crudo"/>
    <menuitem id="menu_reporte_stock_pasty"
              name="Inventario Leche Pasteurizada"
              parent="menu_reporte_stock"
              action="action_reporte_stock_pasty"/>

    <menuitem id="menu_reporte_donantes"
              name="Donantes"
              parent="menu_caen_reportes"
              sequence="4"/>
    <menuitem id="menu_reporte_donantes_aptitud"
              name="Donantes por Aptitud"
              parent="menu_reporte_donantes"
              action="action_reporte_donantes_aptitud"/>

    <menuitem id="menu_reporte_alertas_historial"
              name="Historial de Alertas"
              parent="menu_caen_reportes"
              action="action_reporte_alertas"/>

    <menuitem id="menu_reporte_nutricion"
              name="Nutrición"
              parent="menu_caen_reportes"
              action="action_reporte_nutricion"/>

    <!-- ======================== -->
    <!-- REPORTE DE RENDIMIENTO   -->
    <!-- ======================== -->

    <record id="view_rendimiento_list" model="ir.ui.view">
        <field name="name">caen.rendimiento.list</field>
        <field name="model">caen.rendimiento</field>
        <field name="arch" type="xml">
            <list string="Rendimiento" create="false" edit="false">
                <field name="extraction_date"/>
                <field name="donor_id"/>
                <field name="center_id"/>
                <field name="milk_stage"/>
                <field name="target"/>
                <field name="state"/>
                <field name="volume_received" string="Recibido (ml)"/>
                <field name="volume_pasteurized" string="Procesado (ml)"/>
                <field name="volume_discarded" string="Descartado (ml)"/>
                <field name="volume_delivered" string="Entregado (ml)"/>
            </list>
        </field>
    </record>

    <record id="view_rendimiento_pivot" model="ir.ui.view">
        <field name="name">caen.rendimiento.pivot</field>
        <field name="model">caen.rendimiento</field>
        <field name="arch" type="xml">
            <pivot string="Rendimiento del Banco">
                <field name="extraction_date" type="row"/>
                <field name="state" type="col"/>
                <field name="volume_received" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rendimiento_graph" model="ir.ui.view">
        <field name="name">caen.rendimiento.graph</field>
        <field name="model">caen.rendimiento</field>
        <field name="arch" type="xml">
            <graph string="Rendimiento - Recibido vs Procesado vs Descartado" type="bar">
                <field name="state"/>
                <field name="volume_received" type="measure"/>
                <field name="volume_pasteurized" type="measure"/>
                <field name="volume_discarded" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_rendimiento_search" model="ir.ui.view">
        <field name="name">caen.rendimiento.search</field>
        <field name="model">caen.rendimiento</field>
        <field name="arch" type="xml">
            <search string="Buscar Rendimiento">
                <field name="donor_id"/>
                <field name="center_id"/>
                <separator/>
                <filter name="period_3m" string="Últimos 3 meses"
                        domain="[('extraction_date', '&gt;=', 'today -3m')]"/>
                <filter name="period_6m" string="Últimos 6 meses"
                        domain="[('extraction_date', '&gt;=', 'today -6m')]"/>
                <filter name="period_9m" string="Últimos 9 meses"
                        domain="[('extraction_date', '&gt;=', 'today -9m')]"/>
                <filter name="period_12m" string="Últimos 12 meses"
                        domain="[('extraction_date', '&gt;=', 'today -12m')]"/>
                <filter name="period_3m_p" string="Últimos 3 meses (proceso)"
                        domain="[('pasteurization_date', '&gt;=', 'today -3m')]"/>
                <filter name="period_12m_p" string="Últimos 12 meses (proceso)"
                        domain="[('pasteurization_date', '&gt;=', 'today -12m')]"/>
                <separator/>
                <filter name="recibidos" string="Recibidos" domain="[('volume_received', '&gt;', 0)]"/>
                <filter name="descartados" string="Descartados" domain="[('volume_discarded', '&gt;', 0)]"/>
                <filter name="entregados" string="Entregados" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter name="cultivo_positivo" string="Cultivo Positivo" domain="[('culture_result', '=', 'positive')]"/>
                <separator/>
                <group>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'extraction_date'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_donor" string="Donante" context="{'group_by': 'donor_id'}"/>
                    <filter name="group_stage" string="Etapa" context="{'group_by': 'milk_stage'}"/>
                    <filter name="group_target" string="Destino" context="{'group_by': 'target'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_rendimiento" model="ir.actions.act_window">
        <field name="name">Rendimiento del Banco</field>
        <field name="res_model">caen.rendimiento</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_reporte_rendimiento"
              name="Rendimiento del Banco"
              parent="menu_caen_reportes"
              action="action_reporte_rendimiento"/>
</odoo>
