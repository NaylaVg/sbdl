<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caen_paciente_list" model="ir.ui.view">
        <field name="name">caen.paciente.list</field>
        <field name="model">caen.paciente</field>
        <field name="arch" type="xml">
            <list string="Pacientes">
                <field name="name"/>
                <field name="birth_date"/>
                <field name="gestational_age_weeks"/>
                <field name="birth_weight_g"/>
            </list>
        </field>
    </record>

    <record id="view_caen_paciente_form" model="ir.ui.view">
        <field name="name">caen.paciente.form</field>
        <field name="model">caen.paciente</field>
        <field name="arch" type="xml">
            <form string="Paciente">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="birth_date"/>
                        <field name="birth_weight_g"/>
                        <field name="gestational_age_weeks"/>
                        <field name="mother_id"/>
                    </group>
                    <notebook>
                        <page string="Planes de alimentación">
                            <field name="plan_ids">
                                <list string="Planes">
                                    <field name="daily_volume_ml"/>
                                    <field name="frequency_per_day"/>
                                    <field name="kcal_per_day"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Distribuciones recibidas">
                            <field name="distribution_ids">
                                <list string="Distribuciones">
                                    <field name="name"/>
                                    <field name="frasco_id"/>
                                    <field name="distribution_date"/>
                                    <field name="volume_ml"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_paciente" model="ir.actions.act_window">
        <field name="name">Pacientes</field>
        <field name="res_model">caen.paciente</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_paciente"
              name="Pacientes"
              parent="menu_caen_nutricion"
              action="action_caen_paciente"/>
</odoo>
