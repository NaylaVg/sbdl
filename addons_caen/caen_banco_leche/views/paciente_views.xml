<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_caen_paciente_nuevo" model="ir.actions.act_window">
        <field name="name">Nuevo Paciente</field>
        <field name="res_model">caen.paciente</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_caen_paciente"/>
    </record>

    <record id="view_caen_paciente_list" model="ir.ui.view">
        <field name="name">caen.paciente.list</field>
        <field name="model">caen.paciente</field>
        <field name="arch" type="xml">
            <list string="Pacientes">
                <header>
                    <button name="%(action_caen_paciente_nuevo)d" type="action"
                            string="+ Nuevo Paciente" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.perm_pacientes"/>
                </header>
                <field name="name"/>
                <field name="admission_date"/>
                <field name="state"/>
                <field name="birth_date"/>
                <field name="gestational_age_weeks"/>
                <field name="birth_weight_g"/>
                <field name="n_evolutions"/>
            </list>
        </field>
    </record>

    <record id="view_caen_paciente_form" model="ir.ui.view">
        <field name="name">caen.paciente.form</field>
        <field name="model">caen.paciente</field>
        <field name="arch" type="xml">
            <form string="Paciente">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sexo"/>
                            <field name="birth_date"/>
                            <field name="record_number"/>
                            <field name="mother_id"/>
                        </group>
                        <group>
                            <field name="admission_date"/>
                            <field name="state"/>
                            <field name="diagnosis"/>
                        </group>
                    </group>
                    <group string="Datos de nacimiento">
                        <group>
                            <field name="gestational_age_weeks"/>
                            <field name="gestational_age_days"/>
                            <field name="birth_weight_g"/>
                            <field name="birth_height_cm"/>
                            <field name="head_circumference_cm"/>
                        </group>
                        <group>
                            <field name="apgar_1min"/>
                            <field name="apgar_5min"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evolución diaria">
                            <field name="evolution_ids">
                                <list string="Evolución diaria" editable="bottom">
                                    <field name="record_date"/>
                                    <field name="weight_g"/>
                                    <field name="height_cm"/>
                                    <field name="head_circumference_cm"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tratamientos">
                            <group>
                                <field name="treatments" placeholder="Describa aquí la medicación y tratamientos actuales..."/>
                            </group>
                        </page>
                        <page string="Planes de alimentación">
                            <field name="plan_ids">
                                <list string="Planes">
                                    <field name="daily_volume_ml"/>
                                    <field name="frequency_per_day"/>
                                    <field name="kcal_per_day"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Distribuciones recibidas">
                            <field name="distribution_ids">
                                <list string="Distribuciones">
                                    <field name="name"/>
                                    <field name="frasco_id"/>
                                    <field name="distribution_date"/>
                                    <field name="volume_ml"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_paciente" model="ir.actions.act_window">
        <field name="name">Pacientes</field>
        <field name="res_model">caen.paciente</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_paciente"
              name="Pacientes"
              parent="menu_caen_nutricion"
              action="action_caen_paciente"/>
</odoo>