<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_caen_donante_nuevo" model="ir.actions.act_window">
        <field name="name">Nuevo Donante</field>
        <field name="res_model">caen.donante</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_caen_donante"/>
    </record>

    <record id="view_caen_donante_list" model="ir.ui.view">
        <field name="name">caen.donante.list</field>
        <field name="model">caen.donante</field>
        <field name="arch" type="xml">
            <list string="Donantes" create="true">
                <header>
                    <button name="%(action_caen_donante_nuevo)d" type="action"
                            string="+ Nuevo Donante" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.perm_donantes"/>
                </header>
                <field name="name"/>
                <field name="dni"/>
                <field name="phone"/>
                <field name="center_id"/>
                <field name="apta_donar"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_caen_donante_form" model="ir.ui.view">
        <field name="name">caen.donante.form</field>
        <field name="model">caen.donante</field>
        <field name="arch" type="xml">
            <form string="Donante">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="dni"/>
                            <field name="birth_date"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="center_id"/>
                            <field name="next_visit_due"/>
                            <field name="state"/>
                            <field name="serologias_ok"/>
                            <field name="serologias_pendientes"/>
                            <field name="apta_donar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consentimientos">
                            <field name="consent_ids">
                                <list string="Consentimientos">
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Serologías">
                            <field name="serology_ids">
                                <list string="Serologías">
                                    <field name="study_type"/>
                                    <field name="result"/>
                                    <field name="test_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visitas">
                            <field name="visit_ids">
                                <list string="Visitas de donación">
                                    <field name="name"/>
                                    <field name="visit_date"/>
                                    <field name="n_frascos"/>
                                    <field name="volumen_total_ml"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Frascos" invisible="n_frascos == 0">
                            <field name="batch_ids">
                                <list string="Frascos">
                                    <field name="name"/>
                                    <field name="volume_ml"/>
                                    <field name="milk_stage"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_donante" model="ir.actions.act_window">
        <field name="name">Donantes</field>
        <field name="res_model">caen.donante</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_donante"
              name="Donantes"
              parent="menu_caen_donantes"
              action="action_caen_donante"/>
</odoo>
