<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_centro_recoleccion_nuevo" model="ir.actions.act_window">
        <field name="name">Nuevo Centro de Recolección</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_es_centro_recoleccion': True}</field>
    </record>

    <record id="view_centro_recoleccion_list" model="ir.ui.view">
        <field name="name">res.partner.list.centro.recoleccion</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Centros de Recolección">
                <header>
                    <button name="%(action_centro_recoleccion_nuevo)d" type="action"
                            string="+ Nuevo Centro" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.role_admin,caen_banco_leche.role_jefe"/>
                </header>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="horario_atencion"/>
                <field name="referente_centro"/>
            </list>
        </field>
    </record>

    <record id="view_partner_form_centro_recoleccion" model="ir.ui.view">
        <field name="name">res.partner.form.centro.recoleccion</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Centro de Recolección" invisible="not es_centro_recoleccion">
                    <field name="es_centro_recoleccion"/>
                    <field name="horario_atencion"/>
                    <field name="referente_centro"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_centro_recoleccion" model="ir.actions.act_window">
        <field name="name">Centros de Recolección</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_centro_recoleccion', '=', True)]</field>
        <field name="context">{'default_es_centro_recoleccion': True}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_id': ref('view_centro_recoleccion_list'), 'view_mode': 'list'})]"/>
    </record>
</odoo>