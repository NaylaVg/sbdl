<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_caen_visita" model="ir.sequence">
        <field name="name">CAEN Visita</field>
        <field name="code">caen.visita</field>
        <field name="padding">4</field>
    </record>

    <record id="action_caen_visita_nuevo" model="ir.actions.act_window">
        <field name="name">Nueva Visita</field>
        <field name="res_model">caen.visita</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_caen_visita"/>
    </record>

    <record id="view_caen_visita_list" model="ir.ui.view">
        <field name="name">caen.visita.list</field>
        <field name="model">caen.visita</field>
        <field name="arch" type="xml">
            <list string="Visitas de donación">
                <header>
                    <button name="%(action_caen_visita_nuevo)d" type="action"
                            string="+ Nueva Visita" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.perm_visitas"/>
                </header>
                <field name="name"/>
                <field name="donor_id"/>
                <field name="center_id"/>
                <field name="visit_date"/>
                <field name="n_frascos"/>
                <field name="volumen_total_ml"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_caen_visita_form" model="ir.ui.view">
        <field name="name">caen.visita.form</field>
        <field name="model">caen.visita</field>
        <field name="arch" type="xml">
            <form string="Visita de donación">
                <header>
                    <button name="action_marcar_en_curso" type="object"
                            string="Marcar en Curso" class="oe_highlight"
                            invisible="state != 'scheduled'"/>
                    <button name="action_marcar_completada" type="object"
                            string="Completar Visita" class="oe_highlight"
                            invisible="state not in ['scheduled', 'in_progress']"/>
                    <button name="action_cancelar" type="object"
                            string="Cancelar"
                            invisible="state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos de la visita">
                            <field name="name"/>
                            <field name="donor_id" readonly="state in ['done', 'cancelled']"/>
                            <field name="center_id" readonly="state in ['done', 'cancelled']"/>
                            <field name="visit_date" readonly="state in ['done', 'cancelled']"/>
                        </group>
                        <group string="Resumen">
                            <field name="n_frascos"/>
                            <field name="volumen_total_ml"/>
                            <field name="apta_donar"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert" invisible="state not in ['scheduled', 'in_progress']">
                        <p>Registre los frascos donados durante la visita usando el botón
                        <b>"Añadir Frasco"</b>.</p>
                    </div>

                    <notebook>
                        <page string="Frascos donados">
                            <group>
                                <field name="batch_ids">
                                    <list string="Frascos">
                                        <field name="name"/>
                                        <field name="volume_ml"/>
                                        <field name="milk_stage"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                                <button name="action_agregar_frasco" type="object"
                                        string="Añadir Frasco"
                                        invisible="state in ['done', 'cancelled']"/>
                            </group>
                        </page>
                    </notebook>

                    <group string="Observaciones">
                        <field name="observations"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_visita" model="ir.actions.act_window">
        <field name="name">Visitas de donación</field>
        <field name="res_model">caen.visita</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_visita"
              name="Visitas de donación"
              parent="menu_caen_donantes"
              sequence="2"
              action="action_caen_visita"/>
</odoo>
