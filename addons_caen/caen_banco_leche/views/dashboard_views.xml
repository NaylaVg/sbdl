<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caen_dashboard_form" model="ir.ui.view">
        <field name="name">caen.dashboard.form</field>
        <field name="model">caen.dashboard</field>
        <field name="arch" type="xml">
            <form string="Tablero CAEN" create="false" edit="false">
                <sheet>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dashboard_caen_default" model="caen.dashboard">
        <field name="name">Tablero CAEN</field>
    </record>

    <record id="action_caen_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero</field>
        <field name="res_model">caen.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" eval="ref('dashboard_caen_default')"/>
    </record>
</odoo>
