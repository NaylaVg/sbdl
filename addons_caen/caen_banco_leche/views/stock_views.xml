<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caen_stock_leche_list" model="ir.ui.view">
        <field name="name">caen.stock_leche.list</field>
        <field name="model">caen.stock_leche</field>
        <field name="arch" type="xml">
            <list string="Resumen de Inventario" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="milk_stage"/>
                <field name="target"/>
                <field name="location_id"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <record id="view_caen_stock_leche_pivot" model="ir.ui.view">
        <field name="name">caen.stock_leche.pivot</field>
        <field name="model">caen.stock_leche</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de Inventario">
                <field name="location_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_caen_stock_resumen" model="ir.actions.act_window">
        <field name="name">Inventario General</field>
        <field name="res_model">caen.stock_leche</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <menuitem id="menu_caen_stock_resumen"
              name="Inventario"
              parent="menu_caen_root"
              action="action_caen_stock_resumen"
              sequence="4"/>
</odoo>