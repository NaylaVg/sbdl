<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_caen_historia_nuevo" model="ir.actions.act_window">
        <field name="name">Nueva historia perinatal</field>
        <field name="res_model">caen.historia_perinatal</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_caen_historia_perinatal"/>
    </record>

    <record id="view_caen_historia_list" model="ir.ui.view">
        <field name="name">caen.historia_perinatal.list</field>
        <field name="model">caen.historia_perinatal</field>
        <field name="arch" type="xml">
            <list string="Historias perinatales">
                <header>
                    <button name="%(action_caen_historia_nuevo)d" type="action"
                            string="+ Nueva historia" class="o_caen_create_button btn-primary"
                            display="always" groups="caen_banco_leche.perm_donantes"/>
                </header>
                <field name="donor_id"/>
                <field name="fecha"/>
                <field name="n_embarazos"/>
                <field name="n_partos"/>
                <field name="patologia"/>
            </list>
        </field>
    </record>

    <record id="view_caen_historia_form" model="ir.ui.view">
        <field name="name">caen.historia_perinatal.form</field>
        <field name="model">caen.historia_perinatal</field>
        <field name="arch" type="xml">
            <form string="Historia perinatal">
                <sheet>
                    <group>
                        <group>
                            <field name="donor_id"/>
                            <field name="fecha"/>
                            <field name="controles"/>
                        </group>
                        <group>
                            <field name="n_embarazos"/>
                            <field name="n_partos"/>
                            <field name="n_cesareas"/>
                            <field name="n_abortos"/>
                        </group>
                    </group>
                    <group>
                        <field name="patologia"/>
                        <field name="observaciones"/>
                    </group>
                    <notebook>
                        <page string="Bebés">
                            <field name="bebe_ids">
                                <list string="Bebés" editable="bottom">
                                    <field name="orden"/>
                                    <field name="fecha_nac"/>
                                    <field name="semanas"/>
                                    <field name="peso_g"/>
                                    <field name="observaciones"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caen_historia" model="ir.actions.act_window">
        <field name="name">Historias perinatales</field>
        <field name="res_model">caen.historia_perinatal</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_caen_historia"
              name="Historias perinatales"
              parent="menu_caen_donantes"
              action="action_caen_historia"/>
</odoo>
