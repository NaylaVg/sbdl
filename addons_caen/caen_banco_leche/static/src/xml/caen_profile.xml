<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <!-- oculto el systray original que queda dentro de la nav -->
        <xpath expr="//div[contains(@class, 'o_menu_systray')]" position="attributes">
            <attribute name="class" separator=" " add="d-none" />
        </xpath>

        <xpath expr="//nav" position="before">
            <div class="caen-sidebar">
                <div class="caen-sidebar-profile-box" id="caen-profile-box">
                    <img class="caen-sidebar-profile-img" src="/web/static/img/placeholder.png" alt="avatar"/>
                    <span class="caen-sidebar-profile-name">Cargando...</span>
                    <span class="caen-sidebar-profile-role">Banco de Leche Humana</span>
                </div>
                <nav class="caen-sidebar-nav">
                    <a class="caen-sidebar-btn" href="/odoo/action-caen_banco_leche.action_caen_dashboard">
                        <i class="fa fa-home caen-sidebar-icon"/><span>Tablero</span>
                    </a>
                    <a class="caen-sidebar-btn" href="/odoo/action-caen_banco_leche.action_caen_alerta">
                        <i class="fa fa-exclamation-triangle caen-sidebar-icon"/><span>Alertas</span>
                    </a>
                    <details class="caen-sidebar-group">
                        <summary class="caen-sidebar-btn">
                            <i class="fa fa-users caen-sidebar-icon"/><span>Donantes y Consentimientos</span>
                        </summary>
                        <div class="caen-sidebar-submenu">
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_visita">Visitas de Donación</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_donante">Donantes</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_consentimiento">Consentimientos</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_serologia">Serologías</a>
                        </div>
                    </details>
                    <details class="caen-sidebar-group">
                        <summary class="caen-sidebar-btn">
                            <i class="fa fa-cogs caen-sidebar-icon"/><span>Procesamiento</span>
                        </summary>
                        <div class="caen-sidebar-submenu">
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_frasco">Frascos</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_pasteurizacion">Pasteurizaciones</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_fraccionamiento">Fraccionamientos</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_distribucion">Distribuciones</a>
                        </div>
                    </details>
                    <details class="caen-sidebar-group">
                        <summary class="caen-sidebar-btn">
                            <i class="fa fa-heartbeat caen-sidebar-icon"/><span>Nutrición</span>
                        </summary>
                        <div class="caen-sidebar-submenu">
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_paciente">Pacientes</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_caen_plan">Planes de Alimentación</a>
                        </div>
                    </details>
                    <details class="caen-sidebar-group">
                        <summary class="caen-sidebar-btn">
                            <i class="fa fa-bar-chart caen-sidebar-icon"/><span>Reportes</span>
                        </summary>
                        <div class="caen-sidebar-submenu">
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_frascos_donante">Frascos por Donante</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_frascos_estado">Frascos por Estado</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_serologias_resultado">Serologías por Resultado</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_serologias_pendientes">Serologías Pendientes</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_stock_ubicacion">Inventario por Ubicación</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_stock_crudo">Inventario Leche Cruda</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_stock_pasty">Inventario Leche Pasteurizada</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_donantes_aptitud">Donantes por Aptitud</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_alertas">Historial de Alertas</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_reporte_nutricion">Reporte de Nutrición</a>
                        </div>
                    </details>
                    <a class="caen-sidebar-btn" href="/odoo/action-caen_banco_leche.action_caen_stock_resumen">
                        <i class="fa fa-cube caen-sidebar-icon"/><span>Inventario</span>
                    </a>
                    <details class="caen-sidebar-group">
                        <summary class="caen-sidebar-btn">
                            <i class="fa fa-user caen-sidebar-icon"/><span>Usuarios</span>
                        </summary>
                        <div class="caen-sidebar-submenu">
                            <a class="caen-sidebar-child" href="/odoo/action-base.action_res_users">Gestión de Usuarios</a>
                            <a class="caen-sidebar-child" href="/odoo/action-caen_banco_leche.action_users_pending">Pendientes de Aprobación</a>
                        </div>
                    </details>
                    <a class="caen-sidebar-btn" href="/odoo/action-caen_banco_leche.action_caen_bitacora">
                        <i class="fa fa-book caen-sidebar-icon"/><span>Bitácora</span>
                    </a>
                </nav>
                <!-- systray movido aqui dentro del sidebar -->
                <div class="o_menu_systray caen-sidebar-systray d-flex flex-shrink-0 bg-inherit" role="menu">
                    <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                        <div t-att-data-index="item.index"/>
                        <t t-component="item.Component" t-props="item.props"/>
                    </t>
                </div>
            </div>
        </xpath>
    </t>

    <t t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//ActionContainer" position="before">
            <div class="caen-header">
                <div class="caen-header-left">
                    <i class="fa fa-calendar caen-header-icon"/>
                    <span id="caen-datetime">Cargando fecha...</span>
                </div>
                <div class="caen-header-right">
                    <span id="caen-username" class="caen-header-username">Cargando...</span>
                    <div class="caen-header-menu">
                        <button class="caen-hamburger-btn">
                            <i class="fa fa-bars"/>
                        </button>
                        <div class="caen-header-dropdown">
                            <a href="/odoo/action-hr.res_users_action_my"><i class="fa fa-user"/> Mi perfil</a>
                            <a href="/web/session/logout"><i class="fa fa-sign-out"/> Cerrar sesión</a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
