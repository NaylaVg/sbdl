<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="caen_banco_leche.CaenCurvas">
        <div class="o_caen_curvas p-3">
            <div class="btn-group mb-3" role="group">
                <t t-foreach="medidas" t-as="m" t-key="m.id">
                    <button t-attf-class="btn {{ state.medida === m.id ? 'btn-primary' : 'btn-secondary' }}"
                            t-on-click="() => this.cambia(m.id)">
                        <t t-esc="m.nombre"/>
                    </button>
                </t>
            </div>
            <div t-if="state.error" class="alert alert-danger">
                <t t-esc="state.error"/>
            </div>
            <div t-elif="!state.datos">Cargando curvas...</div>
            <div t-else="" style="max-width: 900px;">
                <canvas t-ref="canvas"/>
            </div>
        </div>
    </t>
</templates>
